<?xml version="1.0"?>
<!-- 씬: 빨간 블록 1개 (기본 씬).
     sensors_world 베이스(Sensors 시스템 포함) + red_block 1개를 world에 직접 박아 넣었다.
     launch가 world:=scene_one_block 로 이 파일을 로드하면 팔+카메라(launch가 얹음)+블록이 한 환경에.
     블록을 create로 따로 spawn하지 않고 world에 baking → "환경 안에 다 있다". -->
<sdf version="1.10">
  <world name="empty">
    <physics name="1ms" type="ignored">
      <!-- 파지는 접촉이 지배한다. 5ms에서는 한 스텝에 손가락이
           블록 안으로 파고들어 관절값이 오염됐다(2026-08-07 실측:
           블록을 쥔 채 gripper_joint_1 = -5e-05, 즉 완전 닫힘).
           1ms로 낮춰 관통 깊이를 줄인다. 대가는 물리 계산량 5배. -->
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <!-- 카메라 렌더링에 필요한 Sensors 시스템 -->
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <gravity>0 0 -9.8</gravity>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode/></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>1000</range><linear>0.01</linear><constant>0.9</constant><quadratic>0.001</quadratic></attenuation>
    </light>

    <!-- === 씬 오브젝트: 빨간 블록 1개 (도달 범위 안, 카메라 시야 안) === -->
    <model name="red_block">
      <!-- rpy 단위는 라디안. yaw 0.5236 = 30도.
           축 정렬(yaw 0)로 두면 긴 변이 world y를 향해 검출 yaw가 -90도로 나오는데,
           그 값은 접기 구간 [-90, +90)의 경계라 각도 정확도를 증명하지 못한다.
           비스듬히 돌려놔야 minAreaRect -> 역투영 -> atan2 경로가 실제로 검증된다. -->
      <pose>0.20 0.06 0.02 0 0 0.5236</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>0.0000217</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0000133</iyy><iyz>0</iyz><izz>0.0000217</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.04 0.06 0.04</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.06 0.04</size></box></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
