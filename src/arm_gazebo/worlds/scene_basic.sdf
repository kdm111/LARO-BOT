<?xml version="1.0"?>
<!-- 씬: 기본 배치 (basic).
     물체 셋이 전부 제자리에 있다. 작업 구역이 비어 자가 정리가 발동하지 않는다.
     한 구역에 하나씩만 세운다 - 판 하나가 5cm인데 물체가 6cm라 같은 y에 나란히 두면
     반드시 겹친다. 그래서 창고 둘은 y를 7cm 어긋나게 놓았다.
     초록(불량)의 제자리는 창고가 아니라 수거함이다(agent.py DEST와 같은 판단).
     주문(창고 -> 카운터)을 명령으로 시험하는 출발점.

     구역 5개 (base_link 기준, +y=왼쪽 / +x=카메라에서 먼 쪽 = 화면 위).
     ★ 2026-08-15 : 감으로 잡던 크기를 IK 격자 훑기로 다시 쟀다(sweep + reach_once, phi=-90도).
       사용 가능 영역 = 「IK 도달」 ∩ 「카메라 시야」 ∩ 「반경 0.10 바깥」.
       - 닿는 반경이 높이에 따라 준다 : z=0.08에서 y=0이면 x 0.250, |y|=0.16이면 0.195.
         z=0.10(놓고 물러나는 높이)에서는 각각 0.240 / 0.185.
       - 시야 한계는 |y| 0.255다(HFOV 60도).
       - 안쪽은 r=0.10에서도 팔이 도달해 파지를 시도했다(실측). 자기 충돌로 막히는 벽이 없다.
       아래 사각형은 그 안에서 최대로 키운 것이다. 판 = 구역이고, 판 밖은 계약 밖이다.

       창고(링)   x 0.130~0.180  y +0.100~+0.155    5.0 x  5.5cm  중심(0.1550,+0.1275)
       창고(블록) x 0.045~0.125  y +0.100~+0.200    8.0 x 10.0cm  중심(0.0850,+0.1500)
       작업       x 0.100~0.215  y -0.090~+0.090   11.5 x 18.0cm  중심(0.1575, 0.0000)
       카운터     x 0.045~0.125  y -0.200~-0.100    8.0 x 10.0cm  중심(0.0850,-0.1500)
       수거함     x 0.130~0.180  y -0.155~-0.100    5.0 x  5.5cm  중심(0.1550,-0.1275)

       창고 쌍과 카운터/수거함 쌍이 좌우 대칭이고, 먼 쪽(x 큰 쪽)이 각각 링/수거함이다.
       바깥 구역이 작은 것은 부채꼴이 바깥에서 좁아지기 때문이다 - 억지로 키우면 모서리가
       도달 밖으로 나간다(구 배치의 링 창고가 실제로 그랬다).
     ★ 같은 좌표가 세 곳에 있다 - 하나만 고치면 조용히 어긋난다:
       ① 이 파일의 zone_* 모델 pose  ② agent.py 의 ZONE  ③ skill_server.cpp 의 kTargets
     ★ 구역 판은 visual only(collision 없음)라 물리·파지 실측값에 영향이 없고,
       색이 전부 무채색이라 HSV 마스크에 안 걸린다 - 검출 오염 0. -->
<sdf version="1.10">
  <world name="empty">
    <physics name="1ms" type="ignored">
      <!-- 파지는 접촉이 지배한다. 5ms에서는 한 스텝에 손가락이 물체 안으로 파고든다. -->
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <gravity>0 0 -9.8</gravity>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode/></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>1000</range><linear>0.01</linear><constant>0.9</constant><quadratic>0.001</quadratic></attenuation>
    </light>

    <!-- === 구역 판 5장 === -->
    <model name="zone_shelf">
      <static>true</static>
      <pose>0.154 0.153 0.0005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.05 0.03 0.001</size></box></geometry>
          <material><ambient>0.38 0.38 0.38 1</ambient><diffuse>0.38 0.38 0.38 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 작업 구역 = 실물 A4 석 장 중 가운데 한 장(2026-08-20 저녁). 0.055 x 0.197 (종이에서 세 번 줄인 최종. 좌우가 비대칭이라 중심 y=0.010).
         counter 판과 겹쳐 그려진다 - 겹침은 cell_layout.yaml 에 적어 둔 미해결 항목이다. -->
    <model name="zone_work">
      <static>true</static>
      <pose>0.157 0.010 0.0005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.055 0.197 0.001</size></box></geometry>
          <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>


    <model name="zone_counter">
      <static>true</static>
      <pose>0.154 -0.156 0.0005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.05 0.03 0.001</size></box></geometry>
          <material><ambient>0.88 0.88 0.88 1</ambient><diffuse>0.88 0.88 0.88 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="zone_bin">
      <static>true</static>
      <pose>0.06 -0.225 0.0005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.05 0.03 0.001</size></box></geometry>
          <material><ambient>0.88 0.88 0.88 1</ambient><diffuse>0.88 0.88 0.88 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 빨간 블록 : 블록 창고 -->
    <model name="red_block">
      <pose>0.085 0.085 0.02 0 0 0.5236</pose>
    <!-- spawn 위치(월드 기준). 팔 앞쪽(x=0.20) + 살짝 옆(y=0.06)으로 두어
         현재 쫙 펴진 팔에 가리지 않고 화면에 보이게. 바닥(z=0) 위에 얹히도록 살짝 띄워 놓음.
         값은 잠정 — 화면 보고 조정한다(피킹 도달 범위 안: 이전 pick/place가 x≈0.2, y≈0~0.1에서 성공). -->

    <link name="link">
      <!-- 관성 : 박스(질량 0.05kg) 근사. 동적 물체라 바닥에 얹혀 있다가 나중에 집혀 들린다. -->
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0000217</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.0000133</iyy>
          <iyz>0.0</iyz>
          <izz>0.0000217</izz>
        </inertia>
      </inertial>

      <!-- 충돌 형상 : 바닥·그리퍼와 부딪히는 실제 몸체 -->
      <collision name="collision">
        <geometry>
          <box>
            <size>0.04 0.06 0.04</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- 시각 형상 : 카메라가 보는 빨간 겉모습. HSV 검출이 이 빨강을 찾는다. -->
      <visual name="visual">
        <geometry>
          <box>
            <size>0.04 0.06 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>1.0 0.0 0.0 1</ambient>
          <diffuse>1.0 0.0 0.0 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
  </model>

    <!-- 초록 블록(불량) : 수거함. 불량품의 제자리는 창고가 아니라 여기다 -->
    <model name="green_block">
      <pose>0.085 -0.175 0.02 0 0 0.7854</pose>

    <link name="link">
      <!-- 관성 : 박스(질량 0.05kg) 근사. red_block과 같은 값. -->
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0000217</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.0000133</iyy>
          <iyz>0.0</iyz>
          <izz>0.0000217</izz>
        </inertia>
      </inertial>

      <!-- 충돌 형상 : 바닥·그리퍼와 부딪히는 실제 몸체 -->
      <collision name="collision">
        <geometry>
          <box>
            <size>0.04 0.06 0.04</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- 시각 형상 : HSV 검출이 이 초록을 찾는다. -->
      <visual name="visual">
        <geometry>
          <box>
            <size>0.04 0.06 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.75 0.15 1</ambient>
          <diffuse>0.05 0.75 0.15 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
  </model>

    <!-- 파란 링 : 링 창고 -->
    <model name="blue_ring">
      <pose>0.085 0.175 0.0 0 0 0.0</pose>
    <link name='link'>
      <inertial>
        <mass>0.04</mass>
        <!-- 속 빈 원통 근사: izz = m/2*(Ro^2+Ri^2), ixx=iyy = m/12*(3*(Ro^2+Ri^2)+h^2) -->
        <inertia>
          <ixx>1.254e-05</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1.254e-05</iyy><iyz>0</iyz><izz>2.413e-05</izz>
        </inertia>
      </inertial>
      <collision name='ring_col_0'>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
      </collision>
      <visual name='ring_vis_0'>
        <pose>0.02375 0.00000 0.00600 0 0 0.00000</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
        <material>
          <ambient>0.05 0.25 0.9 1</ambient>
          <diffuse>0.05 0.25 0.9 1</diffuse>
        </material>
      </visual>
      <collision name='ring_col_1'>
        <pose>0.02194 0.00909 0.00600 0 0 0.39270</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
      </collision>
      <visual name='ring_vis_1'>
        <pose>0.02194 0.00909 0.00600 0 0 0.39270</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
        <material>
          <ambient>0.05 0.25 0.9 1</ambient>
          <diffuse>0.05 0.25 0.9 1</diffuse>
        </material>
      </visual>
      <collision name='ring_col_2'>
        <pose>0.01679 0.01679 0.00600 0 0 0.78540</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
      </collision>
      <visual name='ring_vis_2'>
        <pose>0.01679 0.01679 0.00600 0 0 0.78540</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
        <material>
          <ambient>0.05 0.25 0.9 1</ambient>
          <diffuse>0.05 0.25 0.9 1</diffuse>
        </material>
      </visual>
      <collision name='ring_col_3'>
        <pose>0.00909 0.02194 0.00600 0 0 1.17810</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
      </collision>
      <visual name='ring_vis_3'>
        <pose>0.00909 0.02194 0.00600 0 0 1.17810</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
        <material>
          <ambient>0.05 0.25 0.9 1</ambient>
          <diffuse>0.05 0.25 0.9 1</diffuse>
        </material>
      </visual>
      <collision name='ring_col_4'>
        <pose>0.00000 0.02375 0.00600 0 0 1.57080</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
      </collision>
      <visual name='ring_vis_4'>
        <pose>0.00000 0.02375 0.00600 0 0 1.57080</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
        <material>
          <ambient>0.05 0.25 0.9 1</ambient>
          <diffuse>0.05 0.25 0.9 1</diffuse>
        </material>
      </visual>
      <collision name='ring_col_5'>
        <pose>-0.00909 0.02194 0.00600 0 0 1.96350</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
      </collision>
      <visual name='ring_vis_5'>
        <pose>-0.00909 0.02194 0.00600 0 0 1.96350</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
        <material>
          <ambient>0.05 0.25 0.9 1</ambient>
          <diffuse>0.05 0.25 0.9 1</diffuse>
        </material>
      </visual>
      <collision name='ring_col_6'>
        <pose>-0.01679 0.01679 0.00600 0 0 2.35619</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
      </collision>
      <visual name='ring_vis_6'>
        <pose>-0.01679 0.01679 0.00600 0 0 2.35619</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
        <material>
          <ambient>0.05 0.25 0.9 1</ambient>
          <diffuse>0.05 0.25 0.9 1</diffuse>
        </material>
      </visual>
      <collision name='ring_col_7'>
        <pose>-0.02194 0.00909 0.00600 0 0 2.74889</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
      </collision>
      <visual name='ring_vis_7'>
        <pose>-0.02194 0.00909 0.00600 0 0 2.74889</pose>
