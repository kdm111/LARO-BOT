<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arm_agent</name>
  <version>0.0.1</version>
  <description>Agent node: interprets commands and drives Pick/Place skills (single-arm).</description>
  <maintainer email="pjsu94@gmail.com">kdm111</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <!-- ★ 2026-08-22 위생: agent.py 가 arm_interfaces 의 action/msg 를 실제로
       import 하는데 선언이 빠져 있었다 - CI 가 packages-select 순서로 우연히
       통과하던 상태. 빌드 순서·rosdep 보장을 위해 명시한다. -->
  <depend>arm_interfaces</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
