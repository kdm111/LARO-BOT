<?xml version="1.0"?>
<!-- 초록 직육면체 블록 — 불량품 역할. red_block과 모양·크기·질량이 같고 색만 다르다.
     크기(x,y,z) = 0.04 x 0.06 x 0.04 m, 질량 0.05kg — red_block.sdf와 동일.
     "한 색 = 한 물체" 계약이라 색이 곧 identity다. 같은 모양이라도 초록이면 다른 물체다.
     ★ 모양이 같으므로 파지 파라미터도 red_block과 같은 값을 쓴다
       (skill_server.cpp kGrasps, object_detector.py OBJECTS의 plane_z/min_long).
     ★ 색 RGB(0.05, 0.75, 0.15) = OpenCV H 64 부근. 빨강(H 0/175)·파랑(H 113)과
       충분히 떨어져 있어 마스크가 겹치지 않는다. -->
<sdf version="1.10">
  <model name="green_block">
    <pose>0.21 0.06 0.021 0 0 0</pose>

    <link name="link">
      <!-- 관성 : 박스(질량 0.05kg) 근사. red_block과 같은 값. -->
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0000217</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.0000133</iyy>
          <iyz>0.0</iyz>
          <izz>0.0000217</izz>
        </inertia>
      </inertial>

      <!-- 충돌 형상 : 바닥·그리퍼와 부딪히는 실제 몸체 -->
      <collision name="collision">
        <geometry>
          <box>
            <size>0.04 0.06 0.04</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- 시각 형상 : HSV 검출이 이 초록을 찾는다. -->
      <visual name="visual">
        <geometry>
          <box>
            <size>0.04 0.06 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.75 0.15 1</ambient>
          <diffuse>0.05 0.75 0.15 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
