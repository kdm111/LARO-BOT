        </material>
      </visual>
      <collision name='ring_col_14'>
        <pose>0.01679 -0.01679 0.00600 0 0 5.49779</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
      </collision>
      <visual name='ring_vis_14'>
        <pose>0.01679 -0.01679 0.00600 0 0 5.49779</pose>
