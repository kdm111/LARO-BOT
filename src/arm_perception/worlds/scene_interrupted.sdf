        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
        <material>
          <ambient>0.05 0.25 0.9 1</ambient>
          <diffuse>0.05 0.25 0.9 1</diffuse>
        </material>
      </visual>
      <collision name='ring_col_2'>
        <pose>0.01679 0.01679 0.00600 0 0 0.78540</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
      </collision>
      <visual name='ring_vis_2'>
        <pose>0.01679 0.01679 0.00600 0 0 0.78540</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
        <material>
          <ambient>0.05 0.25 0.9 1</ambient>
          <diffuse>0.05 0.25 0.9 1</diffuse>
        </material>
      </visual>
      <collision name='ring_col_3'>
        <pose>0.00909 0.02194 0.00600 0 0 1.17810</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
      </collision>
      <visual name='ring_vis_3'>
        <pose>0.00909 0.02194 0.00600 0 0 1.17810</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
        <material>
          <ambient>0.05 0.25 0.9 1</ambient>
          <diffuse>0.05 0.25 0.9 1</diffuse>
        </material>
      </visual>
      <collision name='ring_col_4'>
        <pose>0.00000 0.02375 0.00600 0 0 1.57080</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
      </collision>
      <visual name='ring_vis_4'>
        <pose>0.00000 0.02375 0.00600 0 0 1.57080</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
        <material>
          <ambient>0.05 0.25 0.9 1</ambient>
          <diffuse>0.05 0.25 0.9 1</diffuse>
        </material>
      </visual>
      <collision name='ring_col_5'>
        <pose>-0.00909 0.02194 0.00600 0 0 1.96350</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
      </collision>
      <visual name='ring_vis_5'>
        <pose>-0.00909 0.02194 0.00600 0 0 1.96350</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
        <material>
          <ambient>0.05 0.25 0.9 1</ambient>
          <diffuse>0.05 0.25 0.9 1</diffuse>
        </material>
      </visual>
      <collision name='ring_col_6'>
        <pose>-0.01679 0.01679 0.00600 0 0 2.35619</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
      </collision>
      <visual name='ring_vis_6'>
        <pose>-0.01679 0.01679 0.00600 0 0 2.35619</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
        <material>
          <ambient>0.05 0.25 0.9 1</ambient>
          <diffuse>0.05 0.25 0.9 1</diffuse>
        </material>
      </visual>
      <collision name='ring_col_7'>
        <pose>-0.02194 0.00909 0.00600 0 0 2.74889</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
      </collision>
