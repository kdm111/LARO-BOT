        </material>
      </visual>
      <collision name='ring_col_8'>
        <pose>-0.02375 0.00000 0.00600 0 0 3.14159</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
      </collision>
