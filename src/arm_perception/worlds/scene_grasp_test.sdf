<?xml version="1.0"?>
<!-- 씬: 파지 시험대. 빨간 블록(4x6x4cm) 1개 + 파란 도넛 1개.
     용도 두 가지.
       (1) theta5 상수 판정 - 블록 yaw 0이라 긴 변(6cm)이 world y를 향한다.
           그리퍼가 world x로 닫으면 상수 0, y로 닫으면 90도가 필요하다.
       (2) 그리퍼 개구부 최대 폭 실측(§4.5 미확인 항목).
           구 블록 2.5cm는 물었고 4cm는 미확인이다.
     종이컵은 제거했다(카드 §3.3-6이 발동하면 git 이력에서 복원). -->
<sdf version="1.10">
  <world name="empty">
    <physics name="1ms" type="ignored">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <gravity>0 0 -9.8</gravity>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode/></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>1000</range><linear>0.01</linear><constant>0.9</constant><quadratic>0.001</quadratic></attenuation>
    </light>

    <!-- === 씬 오브젝트: 빨간 블록 1개 + 파란 도넛 1개 + 종이컵 1개 ===
         목적: 내부 파지(그리퍼를 닫은 채 넣고 벌리기)를 눈으로 확인하기 위한 실험 씬.
         컵/링은 벽이 상자 16개로 쪼개져 있어 가운데 구멍이 진짜 비어 있다.
         치수는 임시값 - 실물 자로 재서 교체할 것. -->
    <model name="red_block">
      <!-- y=0 : theta1 = atan2(0, x) = 0 이 되는 자리.
           그러면 grasp_yaw = 0, theta5 = 0이라 j5 롤축의 부호가 어느 쪽이든
           닫힘 축이 world x에 놓인다 = 블록 짧은 축(4cm)과 완벽 정렬.
           "정렬은 맞는데 못 잡는다"면 원인은 그리퍼 개구부 폭 하나로 좁혀진다.
           ⚠ 이 자리는 카메라 시선이 팔에 막혀 검출이 안 된다(카메라도 팔도 y=0).
              검출기 대신 /scene_state를 손으로 발행할 것. -->
      <pose>0.19 0.00 0.02 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>0.0000217</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0000133</iyy><iyz>0</iyz><izz>0.0000217</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.04 0.06 0.04</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.06 0.04</size></box></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>

    <model name='blue_ring'>
          <pose>0.19 -0.07 0.001 0 0 0</pose>
        <link name='link'>
          <inertial>
            <mass>0.040</mass>
            <inertia>
              <ixx>1.5e-05</ixx><ixy>0</ixy><ixz>0</ixz>
              <iyy>1.5e-05</iyy><iyz>0</iyz><izz>2.9e-05</izz>
            </inertia>
          </inertial>
          <collision name='ring_col_0'>
            <pose>0.02650 0.00000 0.00900 0 0 0.00000</pose>
            <geometry><box><size>0.01700 0.01093 0.01800</size></box></geometry>
          </collision>
          <visual name='ring_vis_0'>
            <pose>0.02650 0.00000 0.00900 0 0 0.00000</pose>
            <geometry><box><size>0.01700 0.01093 0.01800</size></box></geometry>
            <material>
              <ambient>0.05 0.25 0.9 1</ambient>
              <diffuse>0.05 0.25 0.9 1</diffuse>
            </material>
          </visual>
