<?xml version="1.0"?>
<!-- 씬: 셀 레이아웃 3구역 (창고 / 작업 / 서빙).
     scene_one_block의 베이스(physics·Sensors·ground·light)를 그대로 쓰고
     구역 바닥판 3장 + 빨간 블록 1개(가운데 = 방치 상태)만 얹었다.

     구역 4개 (base_link 기준, +y=왼쪽 / +x=카메라에서 먼 쪽 = 화면 위).
       창고(링)   (0.19, +0.16)  r=0.248  블록 창고 바로 위. 파란 링 재고.
       창고(블록) (0.12, +0.16)  r=0.200  빨간 블록 재고이자 정리 목적지.
       작업       (0.21, +0.06)  r=0.218  여기 놓인 물체가 정리 대상.
       서빙       (0.15, -0.15)  r=0.212  주문의 종착지.
     ★ 반경 상한은 실측이다(2026-08-14): 같은 블록을 pick 할 때
       r=0.233 / 0.248 성공, r=0.270 / 0.280 실패. 그래서 링 창고를 0.248에 두었다.
     창고 둘의 간격은 0.07이라 판을 6cm로 줄였다. 구역 판정은 반경이 아니라
     '가장 가까운 구역'이라(agent.py zone_of) 간격이 좁아도 갈린다.

     ⚠ 작업 구역이 y=0(팔 정면)이 아니라 +0.06인 이유 - 2026-08-14 실측:
     y=0에서는 pick이 재현성 있게 실패한다(x=0.20/0.25 각각, 파지 판정 관절 0.0275
     vs 성공 시 0.33~0.49 = 완전 헛집음). 좌우 대칭인 y=+0.06/-0.06은 둘 다 성공.
     원인 미규명 - 정면 파지 결함으로 카드에 남기고, 레이아웃은 그 줄을 피해 간다.

     ⚠ 빨간 블록은 하나뿐이다. red_block_detector.py:199가 object_id를 'red_block'
     문자열로 고정하므로(계약: "한 색 = 한 물체") 같은 색을 둘 두면 id가 충돌한다.
     창고에도 재고를 두려면 인지 쪽 id 부여를 먼저 고쳐야 한다. -->
<sdf version="1.10">
  <world name="empty">
    <physics name="1ms" type="ignored">
      <!-- 파지는 접촉이 지배한다. scene_one_block과 같은 이유로 1ms. -->
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <!-- 카메라 렌더링에 필요한 Sensors 시스템 -->
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <gravity>0 0 -9.8</gravity>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode/></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>1000</range><linear>0.01</linear><constant>0.9</constant><quadratic>0.001</quadratic></attenuation>
    </light>

    <!-- === 구역 바닥판 3장 ===
         눈과 영상 자막을 위한 표식일 뿐이라 collision이 없다(visual only).
         물리에 관여하지 않으므로 파지·접촉 실측값이 바뀌지 않는다.
         색은 전부 무채색(R=G=B)이다. 검출기가 HSV 빨강 마스크를 쓰므로
         채도 0인 회색은 어떤 밝기여도 마스크에 안 걸린다 - 검출 오염 0. -->
    <model name="zone_shelf_ring">
      <static>true</static>
      <pose>0.19 0.16 0.0005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.06 0.06 0.001</size></box></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="zone_shelf_block">
      <static>true</static>
      <pose>0.12 0.16 0.0005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.06 0.06 0.001</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="zone_work">
      <static>true</static>
      <pose>0.21 0.06 0.0005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.06 0.06 0.001</size></box></geometry>
          <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="zone_serve">
      <static>true</static>
      <pose>0.15 -0.15 0.0005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.06 0.06 0.001</size></box></geometry>
          <material><ambient>0.72 0.72 0.72 1</ambient><diffuse>0.72 0.72 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- === 씬 오브젝트: 빨간 블록 1개, 가운데(작업 구역)에 방치 ===
         yaw 0.5236(30도)는 scene_one_block과 같은 이유다 - 축 정렬로 두면
         검출 yaw가 접기 구간 경계인 -90도로 나와 각도 정확도를 증명하지 못한다. -->
    <model name="red_block">
      <pose>0.21 0.06 0.02 0 0 0.5236</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>0.0000217</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0000133</iyy><iyz>0</iyz><izz>0.0000217</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.04 0.06 0.04</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.06 0.04</size></box></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- === 파란 링 : 링 창고에 배치 ===
         models/blue_ring.sdf 를 그대로 박았다(<include>는 리소스 경로가 필요해 안 쓴다).
         링 전용 창고에 둔다. 블록 창고와 나눈 이유는 정리 목적지가 물체마다 달라서다
         (agent.py DEST). 한 판에 둘을 놓으면 정리된 블록과 재고 링이 부딪힌다.
         회전 대칭이라 yaw는 파지에 영향을 주지 않는다(blue_ring.sdf 주석). -->
    <model name='blue_ring'>
      <pose>0.19 0.16 0 0 0 0</pose>
    <link name='link'>
      <inertial>
        <mass>0.04</mass>
        <!-- 속 빈 원통 근사: izz = m/2*(Ro^2+Ri^2), ixx=iyy = m/12*(3*(Ro^2+Ri^2)+h^2) -->
        <inertia>
          <ixx>1.254e-05</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1.254e-05</iyy><iyz>0</iyz><izz>2.413e-05</izz>
        </inertia>
      </inertial>
      <collision name='ring_col_0'>
        <pose>0.02375 0.00000 0.00600 0 0 0.00000</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
      </collision>
      <visual name='ring_vis_0'>
        <pose>0.02375 0.00000 0.00600 0 0 0.00000</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
        <material>
          <ambient>0.05 0.25 0.9 1</ambient>
          <diffuse>0.05 0.25 0.9 1</diffuse>
        </material>
      </visual>
      <collision name='ring_col_1'>
        <pose>0.02194 0.00909 0.00600 0 0 0.39270</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
      </collision>
      <visual name='ring_vis_1'>
        <pose>0.02194 0.00909 0.00600 0 0 0.39270</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
        <material>
          <ambient>0.05 0.25 0.9 1</ambient>
          <diffuse>0.05 0.25 0.9 1</diffuse>
        </material>
      </visual>
      <collision name='ring_col_2'>
        <pose>0.01679 0.01679 0.00600 0 0 0.78540</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
      </collision>
      <visual name='ring_vis_2'>
        <pose>0.01679 0.01679 0.00600 0 0 0.78540</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
        <material>
          <ambient>0.05 0.25 0.9 1</ambient>
          <diffuse>0.05 0.25 0.9 1</diffuse>
        </material>
      </visual>
      <collision name='ring_col_3'>
        <pose>0.00909 0.02194 0.00600 0 0 1.17810</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
      </collision>
      <visual name='ring_vis_3'>
        <pose>0.00909 0.02194 0.00600 0 0 1.17810</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
        <material>
          <ambient>0.05 0.25 0.9 1</ambient>
          <diffuse>0.05 0.25 0.9 1</diffuse>
        </material>
      </visual>
      <collision name='ring_col_4'>
        <pose>0.00000 0.02375 0.00600 0 0 1.57080</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
      </collision>
      <visual name='ring_vis_4'>
        <pose>0.00000 0.02375 0.00600 0 0 1.57080</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
        <material>
          <ambient>0.05 0.25 0.9 1</ambient>
          <diffuse>0.05 0.25 0.9 1</diffuse>
        </material>
      </visual>
      <collision name='ring_col_5'>
        <pose>-0.00909 0.02194 0.00600 0 0 1.96350</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
      </collision>
      <visual name='ring_vis_5'>
        <pose>-0.00909 0.02194 0.00600 0 0 1.96350</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
        <material>
          <ambient>0.05 0.25 0.9 1</ambient>
          <diffuse>0.05 0.25 0.9 1</diffuse>
        </material>
      </visual>
      <collision name='ring_col_6'>
        <pose>-0.01679 0.01679 0.00600 0 0 2.35619</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
      </collision>
      <visual name='ring_vis_6'>
        <pose>-0.01679 0.01679 0.00600 0 0 2.35619</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
        <material>
          <ambient>0.05 0.25 0.9 1</ambient>
          <diffuse>0.05 0.25 0.9 1</diffuse>
        </material>
      </visual>
      <collision name='ring_col_7'>
        <pose>-0.02194 0.00909 0.00600 0 0 2.74889</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
      </collision>
      <visual name='ring_vis_7'>
        <pose>-0.02194 0.00909 0.00600 0 0 2.74889</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
        <material>
          <ambient>0.05 0.25 0.9 1</ambient>
          <diffuse>0.05 0.25 0.9 1</diffuse>
        </material>
      </visual>
      <collision name='ring_col_8'>
        <pose>-0.02375 0.00000 0.00600 0 0 3.14159</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
      </collision>
      <visual name='ring_vis_8'>
        <pose>-0.02375 0.00000 0.00600 0 0 3.14159</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
        <material>
          <ambient>0.05 0.25 0.9 1</ambient>
          <diffuse>0.05 0.25 0.9 1</diffuse>
        </material>
      </visual>
      <collision name='ring_col_9'>
        <pose>-0.02194 -0.00909 0.00600 0 0 3.53429</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
      </collision>
      <visual name='ring_vis_9'>
        <pose>-0.02194 -0.00909 0.00600 0 0 3.53429</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
        <material>
          <ambient>0.05 0.25 0.9 1</ambient>
          <diffuse>0.05 0.25 0.9 1</diffuse>
        </material>
      </visual>
      <collision name='ring_col_10'>
        <pose>-0.01679 -0.01679 0.00600 0 0 3.92699</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
      </collision>
      <visual name='ring_vis_10'>
        <pose>-0.01679 -0.01679 0.00600 0 0 3.92699</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
        <material>
          <ambient>0.05 0.25 0.9 1</ambient>
          <diffuse>0.05 0.25 0.9 1</diffuse>
        </material>
      </visual>
      <collision name='ring_col_11'>
        <pose>-0.00909 -0.02194 0.00600 0 0 4.31969</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
      </collision>
      <visual name='ring_vis_11'>
        <pose>-0.00909 -0.02194 0.00600 0 0 4.31969</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
        <material>
          <ambient>0.05 0.25 0.9 1</ambient>
          <diffuse>0.05 0.25 0.9 1</diffuse>
        </material>
      </visual>
      <collision name='ring_col_12'>
        <pose>-0.00000 -0.02375 0.00600 0 0 4.71239</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
      </collision>
      <visual name='ring_vis_12'>
        <pose>-0.00000 -0.02375 0.00600 0 0 4.71239</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
        <material>
          <ambient>0.05 0.25 0.9 1</ambient>
          <diffuse>0.05 0.25 0.9 1</diffuse>
        </material>
      </visual>
      <collision name='ring_col_13'>
        <pose>0.00909 -0.02194 0.00600 0 0 5.10509</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
      </collision>
      <visual name='ring_vis_13'>
        <pose>0.00909 -0.02194 0.00600 0 0 5.10509</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
        <material>
          <ambient>0.05 0.25 0.9 1</ambient>
          <diffuse>0.05 0.25 0.9 1</diffuse>
        </material>
      </visual>
      <collision name='ring_col_14'>
        <pose>0.01679 -0.01679 0.00600 0 0 5.49779</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
      </collision>
      <visual name='ring_vis_14'>
        <pose>0.01679 -0.01679 0.00600 0 0 5.49779</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
        <material>
          <ambient>0.05 0.25 0.9 1</ambient>
