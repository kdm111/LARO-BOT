        </material>
      </visual>
      <collision name='ring_col_15'>
        <pose>0.02194 -0.00909 0.00600 0 0 5.89049</pose>
        <geometry><box><size>0.01250 0.00980 0.01200</size></box></geometry>
      </collision>
      <visual name='ring_vis_15'>
        <pose>0.02194 -0.00909 0.00600 0 0 5.89049</pose>
