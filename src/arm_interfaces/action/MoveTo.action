# MoveTo: 사전 정의된 pose로 이동

# ---- Goal ----
string pose_id                         # 움직여야 할 pose (SRDF group_state 이름)
uint8  attempt                         # 시도 횟수
---
# ---- Result ----
bool success                           # 성공 여부
FailureReport failure                  # 실패 상세. success=true failure.code == SUCCESS
---
# ---- Feedback ----
string stage                           # 단계별 동작
float32 progress                       # 진행률
